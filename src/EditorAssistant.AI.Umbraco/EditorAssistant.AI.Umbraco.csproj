<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
	<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>EditorAssistant.AI.Umbraco</PackageId>
	<Product>Umbraco.EditorAssistant.AI</Product>
    <Version>1.2.0</Version>
    <Authors>Alaeddin Alhamoud</Authors>
	<Copyright>Copyright © 2026 Alaeddin Alhamoud</Copyright>
    <Description>AI writing and page summaries for Umbraco 17. Generate and improve rich text with an editor toolbar assistant, and let website visitors summarize pages using a shared, securely configured AI provider.</Description>
	<PackageReleaseNotes>AI Assistant for Umbraco 17:
- Add a Rich Text Editor toolbar assistant to generate drafts, improve selected text, and preview results before inserting or replacing content.
- Include optional field context, with an accessible info tooltip explaining how it is used.
- Introduce a responsive prompt dialog with separate instruction and preview panels, themed icons, and clearer action buttons.
- Refresh the backoffice setup layout with theme-aware colours and feature setup guidance.
- Control public page summaries independently with the Enable page summaries switch; rich text generation remains available when summaries are disabled.
- Verify the shared provider connection before saving settings and protect stored credentials with ASP.NET Core Data Protection.
- Support Azure OpenAI, OpenAI, Claude, Gemini, DeepSeek, and Ollama; cache identical page summaries for one day while editor generation and connection tests bypass the cache.
- Update installation, configuration, privacy, and development documentation.</PackageReleaseNotes>
    <PackageTags>umbraco;ai;assistant;openai;azure-openai;gemini;claude;deepseek;ollama;summarization</PackageTags>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
	<PackageProjectUrl>https://github.com/Alaeddinalhamoud/Umbraco.EditorAssistant.AI</PackageProjectUrl>
	<RepositoryUrl>https://github.com/Alaeddinalhamoud/Umbraco.EditorAssistant.AI</RepositoryUrl>
    <Product>EditorAssistant.AI.Umbraco</Product>
    <Title>EditorAssistant.AI.Umbraco</Title>
    <PackageIcon>package-icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
	<IsPackable>true</IsPackable>
  </PropertyGroup>


  <!-- Central package management - no versions -->
  <ItemGroup>
    <PackageReference Include="OllamaSharp" />
    <PackageReference Include="Umbraco.Cms.Api.Common" />
    <PackageReference Include="Umbraco.Cms.Api.Management" />
    <PackageReference Include="Umbraco.Cms.Core" />
    <PackageReference Include="Umbraco.Cms.Web.Common" />
    <PackageReference Include="Umbraco.Cms.Web.Website" />

    <!--
      Microsoft.AspNetCore.OpenApi is available transitively from the Umbraco packages above, but we
      take a direct dependency here because extension code directly uses types from this package
      (IOpenApiDocumentTransformer, IOpenApiOperationTransformer, etc.) and from Microsoft.OpenApi
      (OpenApiInfo). Without a direct reference, this project's Microsoft.AspNetCore.OpenApi version
      is determined solely by NuGet's transitive resolution, which can resolve to a different version
      than the host site project (e.g. a newer patch). When that happens, the different
      Microsoft.OpenApi versions can conflict at runtime, causing custom OpenAPI documents registered
      by the extension to fail to appear.
      Most other transitive dependencies don't have this problem because extension code doesn't use
      their types directly - only Microsoft.AspNetCore.OpenApi / Microsoft.OpenApi types are
      referenced in the composer.
    -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Microsoft.Extensions.AI.Ollama" />
  </ItemGroup>


  <ItemGroup>
    <!-- Don't include the client folder as part of packaging nuget build -->
    <Content Remove="Client\**" />

    <!-- However make the Umbraco-package.json included for dotnet pack or nuget package and visible to the solution -->
    <None Include="Client\public\umbraco-package.json" Pack="false" />
    <None Include="package-icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <Content Update="wwwroot\App_Plugins\**" Pack="true" PackagePath="wwwroot\App_Plugins\" />
  </ItemGroup>


  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

</Project>
