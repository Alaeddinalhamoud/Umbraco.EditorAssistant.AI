<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Allow floating versions so extensions can align with the host Umbraco project's package versions -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Umbraco API packages - Used by extension templates -->
    <PackageVersion Include="Google.GenAI" Version="2.1.0" />
    <PackageVersion Include="OllamaSharp" Version="5.5.2" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Umbraco.Cms.Api.Common" Version="17.8.1" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="17.8.1" />
    <PackageVersion Include="Umbraco.Cms.Core" Version="17.8.1" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="17.8.1" />
    <PackageVersion Include="Umbraco.Cms.Web.Website" Version="17.8.1" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
  </ItemGroup>
</Project>